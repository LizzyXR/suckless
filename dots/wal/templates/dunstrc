[global]
    monitor = 0
    follow = keyboard
    width = (250, 500)
    height = (0, 750)
    offset = (17, 26)
    padding = 5
    horizontal_padding = 5
    gap_size = 3
    transparency = 35
    frame_width = 1
    frame_color="#607566"
    font = Libertinus Mono 11
    corner_radius = 5
    min_icon_size = 32
    max_icon_size = 32
    format = "<b>%s</b>\n%b"

[urgency_low]
    background = "{color0}"
    foreground = "{color15}"
	timeout = 3

[urgency_normal]
    background = "{color0}"
    foreground = "{color15}"
	timeout = 5

[urgency_critical]
    background = "{color1}"
    foreground = "{color15}"
	timeout = 15
